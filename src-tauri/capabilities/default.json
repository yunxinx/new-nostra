{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability: core plus the minimal default permission set of each registered plugin",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:webview:allow-create-webview-window",
    "window-state:default",
    "log:default",
    "updater:default",
    "process:default",
    "clipboard-manager:default",
    "dialog:default",
    "opener:default",
    "store:default"
  ]
}
