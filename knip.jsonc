{
  "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
  // The vite plugin discovers entry scripts from index.html only (hardcoded
  // file name), so the settings window entry is declared here; its subtree
  // stays within analysis. CSS files join `project` so their @imports of
  // tailwindcss / shadcn / font packages are followed (imports of compiled
  // extensions outside `project` are not).
  "entry": ["src/settings-main.tsx"],
  "ignoreExportsUsedInFile": false,
  // 1. shadcn generator emits the full component variant set; trimming to
  //    only what is used would churn on every regeneration.
  "ignoreIssues": {
    "src/components/ui/alert-dialog.tsx": ["exports"],
    "src/components/ui/dropdown-menu.tsx": ["exports"],
    "src/components/ui/popover.tsx": ["exports"],
    "src/components/ui/select.tsx": ["exports"],
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error",
  },
}
