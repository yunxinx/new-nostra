{
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreExportsUsedInFile": false,
  // Settings window entry files. knip's vite plugin discovers entry scripts
  // from index.html only (hardcoded file name), so these cannot be
  // auto-detected.
  "ignore": [
    "src/settings-main.tsx",
    "src/features/settings/SettingsWindowApp.tsx",
  ],
  // 1. shadcn generator emits the full dropdown-menu variant set; trimming to
  //    only what is used would churn on every regeneration.
  // 2. SessionGroupKey / MockMessage complete their modules' public surface
  //    for the upcoming session-domain consumers.
  "ignoreIssues": {
    "src/components/ui/dropdown-menu.tsx": ["exports"],
    "src/features/sessions/grouping.ts": ["types"],
    "src/features/sessions/mock.ts": ["types"],
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error",
  },
}
