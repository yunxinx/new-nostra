    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.13",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
